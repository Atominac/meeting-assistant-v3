# ---------- Database (MongoDB Atlas or a local mongod) ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=meeting_assistant_v3

# ---------- Transcription: Deepgram (https://console.deepgram.com) ----------
# Without a Deepgram key the server falls back to OpenAI Whisper; without either, recordings are saved but not transcribed.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en        # "multi" for calls that mix languages
# ffmpeg mixes the meeting and microphone audio before transcription (brew install ffmpeg). Set this if it is not on PATH.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ---------- AI notes + chat (https://platform.openai.com/api-keys) ----------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# TRANSCRIBE_MODEL=whisper-1  # only used as the fallback when there is no Deepgram key

# ---------- Server ----------
PORT=3002
# Public HTTPS address of this server (needed for Google sign-in redirects and GoHighLevel embedding).
PUBLIC_URL=http://localhost:3002
# Signs short-lived video and Google sign-in links. Set a long random string so they survive restarts.
# SESSION_SECRET=
# DATA_DIR=./data

# ---------- Accounts ----------
# Anyone who can reach the server can create an account unless you set an invite code:
# SIGNUP_CODE=choose-something-secret
# Embedding in GoHighLevel: only these sites may frame the app.
# FRAME_ANCESTORS=https://*.gohighlevel.com https://*.leadconnectorhq.com https://*.msgsndr.com

# ---------- Google Calendar (Google Cloud Console > OAuth client, type "Web application") ----------
# Authorized redirect URI:  <PUBLIC_URL>/api/calendar/google/callback   Scope: calendar.readonly
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
