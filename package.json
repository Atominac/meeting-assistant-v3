{
  "name": "meeting-assistant-v3",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "build": "npm -w web run build",
    "start": "node run-all.mjs",
    "desktop": "npm --prefix desktop run start:app",
    "test": "npm -w server test",
    "build:sdk": "../meeting-sdk/native/macos/build.sh",
    "server": "npm run build && npm -w server run start"
  }
}
